# Copy to .env and fill in locally. Never commit .env. Placeholders only; no real values here.
# Model names are proposals and must be verified before use (docs/decisions.md T-01).

# OpenAI (runtime LLM for all agents)
# CrewAI telemetry and tracing are always turned off in code (src/utils/llm.py); only OpenAI calls leave the machine.
OPENAI_API_KEY=
OPENAI_MODEL=              # proposed: gpt-4.1-mini
OPENAI_FALLBACK_MODEL=     # proposed: gpt-4o-mini
OPENAI_EMBEDDING_MODEL=    # only for RAG; to be decided (T-21)

# LLM usage limits and cost controls (starting values, tune after the first real run)
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_CALLS_PER_RUN=100
LLM_MAX_TOKENS_PER_RUN=200000

# Data scope (T-02)
STORE_ID=CA_1

# Storage backend: local (default) or supabase
REPOSITORY_BACKEND=local

# Supabase (optional, only when REPOSITORY_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Reproducibility and logging
RANDOM_SEED=42
LOG_LEVEL=INFO
