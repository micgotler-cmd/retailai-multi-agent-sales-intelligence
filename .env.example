# Copy to .env and fill in locally. Never commit .env. Placeholders only.

# LLM / embeddings (provider and models are TBD, see docs/decisions.md T-01)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Storage backend: local (default) or supabase
REPOSITORY_BACKEND=local

# Supabase (optional, only when REPOSITORY_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Reproducibility and logging
RANDOM_SEED=42
LOG_LEVEL=INFO
